# Database
DATABASE_URL="mysql://user:password@localhost:3306/hexavante"

# Auth – Better Auth secret key (min 32 chars, generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-min-32-chars"

# Redis (usado para cache de sessões, rate-limit, tokens de verificação, OTP)
REDIS_URL="redis://localhost:6379"

# Server
PORT=3045
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN="https://hexavante.com,https://app.hexavante.com"

# Rate Limit
# RATE_LIMIT_MAX é override do limite global por IP (default 1000/min — o
# tráfego server-side do Next compartilha o bucket do IP do container).
# Limites por rota (login 10, register 5, exchange 10) são independentes.
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW=1 minute
RATE_LIMIT_ALLOW_LIST="127.0.0.1,::1"

# OAuth – Google (opcional)
# Crie credenciais em https://console.cloud.google.com/apis/credentials
# Configure redirect URI: http://localhost:3045/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth – GitHub (opcional)
# Crie credenciais em https://github.com/settings/developers
# Configure redirect URI: http://localhost:3045/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OAuth – schemes de app nativo aceitos em callbackURL (csv)
# Ex.: mobile/desktop iniciam o fluxo com ?callbackURL=hexavante://auth/callback
OAUTH_NATIVE_SCHEMES="hexavante"

# Mercado Pago (sandbox para teste)
# Credenciais em https://www.mercadopago.com.br/developers/panel/app (Suas integrações)
MP_ACCESS_TOKEN=""
# Pública (só expor se o front precisar; a API não usa em runtime)
MP_PUBLIC_KEY=""
# Opcional: secret do webhook (Tus Integraciones → Webhooks) para validar x-signature
MP_WEBHOOK_SECRET=""
# Base do app usada nas back_urls do checkout Pro
NEXT_PUBLIC_APP_URL="https://app.hexavante.com.br"
