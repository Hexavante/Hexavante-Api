DATABASE_URL=mysql://hexavante:change-me@hexavante-mysql:3306/hexavante
API_PUBLIC_URL=https://desktop-api.hexavante.com.br
REDIS_URL=redis://hexavante-redis:6379
DESKTOP_AUTH_SECRET=generate-a-different-random-secret-with-at-least-32-characters
DESKTOP_TOKEN_SECRET=generate-a-desktop-only-random-secret-with-at-least-32-characters
DESKTOP_TOKEN_ISSUER=https://desktop-api.hexavante.com.br
DESKTOP_TOKEN_AUDIENCE=hexavante-desktop
DESKTOP_CORS_ORIGIN=tauri://localhost,http://tauri.localhost
DESKTOP_RATE_LIMIT_MAX=600
DESKTOP_RATE_LIMIT_TIME_WINDOW=1 minute
DESKTOP_RATE_LIMIT_ALLOW_LIST=127.0.0.1,::1
DESKTOP_LOG_LEVEL=info
DESKTOP_SWAGGER_USER=
DESKTOP_SWAGGER_PASS=
