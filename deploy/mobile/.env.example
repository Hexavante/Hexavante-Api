MOBILE_AUTH_SECRET=generate-a-different-random-secret-with-at-least-32-characters
MOBILE_TOKEN_SECRET=generate-a-mobile-only-random-secret-with-at-least-32-characters
MOBILE_TOKEN_ISSUER=https://mobile-api.hexavante.com.br
MOBILE_TOKEN_AUDIENCE=hexavante-mobile
