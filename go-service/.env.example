# Hexavante API Go — notes, visual e study (a Fastify continua no mesmo domínio)
PORT=3045
NODE_ENV=production
# Mesmo formato aceito pela Fastify (mysql://...) ou DSN nativo Go.
DATABASE_URL=mysql://hexavante:${MYSQL_PASSWORD}@mysql:3306/hexavante
FRONTEND_URL=https://app.hexavante.com.br
# Opcional: sobrescreve a allowlist padrão de CORS (csv)
CORS_ORIGIN=https://hexavante.com.br,https://www.hexavante.com.br,https://app.hexavante.com.br,https://painel.hexavante.com.br
