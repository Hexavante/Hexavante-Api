{
  "name": "hexavante-api",
  "version": "1.0.0",
  "description": "Plataforma educacional Hexavante - API Fastify",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/fix-imports.mjs",
    "start": "node dist/src/server.js",
    "dev:desktop": "tsx watch apps/api-desktop/src/server.ts",
    "dev:mobile": "tsx watch apps/api-mobile/src/server.ts",
    "start:desktop": "node dist/apps/api-desktop/src/server.js",
    "start:mobile": "node dist/apps/api-mobile/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:full": "tsx prisma/seed-full.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src apps packages tests",
    "lint:fix": "eslint src apps packages tests --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:platforms": "vitest run tests/platform-isolation.test.ts tests/platform-contract.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.22",
    "bullmq": "^5.81.5",
    "fastify": "^5.9.0",
    "file-type": "^22.1.1",
    "ioredis": "^5.11.1",
    "jose": "^6.1.0",
    "mercadopago": "^3.6.1",
    "mysql2": "^3.22.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "redis": "^6.0.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ioredis-mock": "^8.13.1",
    "prettier": "^3.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
